## ---- ##
rule qc:
    input:
        expand("samples/{sample}/sequence_quality_control/finished_QC", sample=SAMPLES),
        read_counts="stats/read_counts.tsv",
        read_length_stats=["stats/insert_stats.tsv", "stats/read_length_stats.tsv"],
        report="reports/qc_report.html",
    output:
        touch("finished_QC"),


## ---- ##
rule assembly_one_sample:
    input:
        get_assembly,
        "samples/{sample}/assembly/contig_stats/postfilter_coverage_stats.txt",
        "samples/{sample}/assembly/contig_stats/final_contig_stats.txt",
    output:
        touch("samples/{sample}/finished_assembly"),

rule assembly:
    input:
        "finished_QC",
        expand("samples/{sample}/finished_assembly", sample=SAMPLES),
        "reports/assembly_report.html",
    output:
        touch("finished_assembly"),


## ---- ##
rule binning:
    input:
        "finished_assembly",
        expand(rules.binning_prokaryotic_genome_stats.output.stats, sample=SAMPLES),
        expand(rules.binning_eukaryotic_genome_stats.output.stats, sample=SAMPLES),
        expand(rules.binning_viral_genome_stats.output.viral_stats, sample=SAMPLES),
        expand(rules.binning_viral_genome_stats.output.plasmid_stats, sample=SAMPLES),
    output:
        temp(touch("finished_binning")),


## ---- ##
def get_bin_reports(wildcards):
    return(expand("reports/bin_report_{lineage}.html", 
                lineage=get_binned_lineages()
            )
    )


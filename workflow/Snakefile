## ---- ##
def get_gene_annotations():
    annotation_file_names = {
        "eggNOG":                       expand("genomes/annotations/{dataset}/genes/emapper.tsv.gz", dataset="genomes"),
        "eggNOG_unbinned":              expand("genomes/annotations/{dataset}/genes/emapper.tsv.gz", dataset="unbinned"),
        "mmseqs2_easy_search":          expand("genomes/annotations/{dataset}/genes/mmseqs2_easy_search_{database_name}.m4.gz", dataset="genomes",  database_name=config["mmseqs2_database_name"]),
        "mmseqs2_easy_search_unbinned": expand("genomes/annotations/{dataset}/genes/mmseqs2_easy_search_{database_name}.m4.gz", dataset="unbinned", database_name=config["mmseqs2_database_name"]),
    }
    annotations_requested = config.get("gene_annotations") or []

    try:
        annotations_files = [
            annotation_file_names[key] for key in annotations_requested
        ]
    except Exception as e:
        raise IOError(
            "Error in gene_annotations requested, check config file 'gene_annotations' "
        ) from e

    return annotations_files

rule gene_annotation:
    input:
        "finished_genomes",
        get_gene_annotations(),
    output:
        temp(touch("finished_gene_annotation")),



## ---- ##
def get_genome_annotations():
    annotation_file_names = {
        "gtdb_tree":                      "genomes/annotations/genomes/tree/finished_gtdb_trees",
        "gtdb_taxonomy":                  "genomes/annotations/genomes/taxonomy/gtdb_taxonomy.tsv",
        "metaeuk":                        expand("genomes/annotations/{dataset}/metaeuk/finished", dataset="genomes"),
        "metaeuk_unbinned":               expand("genomes/annotations/{dataset}/metaeuk/finished", dataset="unbinned"),
        "mmseqs2_easy_taxonomy":          expand("genomes/annotations/{dataset}/mmseqs2_easy_taxonomy/finished", dataset="genomes"),
        "mmseqs2_easy_taxonomy_unbinned": expand("genomes/annotations/{dataset}/mmseqs2_easy_taxonomy/finished", dataset="unbinned"),
    }
    annotations_requested = config["genome_annotations"]

    try:
        annotations_files = [
            annotation_file_names[an] for an in annotations_requested
        ]
    except Exception as e:
        raise IOError(
            "Error in annotations requested, check config file 'genome_annotations' "
        ) from e

    return annotations_files

rule genome_annotation:
    input:
        "finished_genomes",
        *get_genome_annotations(),
    output:
        temp(touch("finished_genome_annotation")),


## ---- ##
rule gene_prediction:
    input:
        "finished_genome_annotation",
        "genomes/annotations/genomes/taxonomy/gtdb_taxonomy.tsv",
        "genomes/genes/genomes",
        "genomes/genes/unbinned",
    output:
        temp(touch("finished_gene_prediction")),


## ---- ##
def get_gene_annotations():
    annotation_file_names = {
        "eggNOG":                       expand("genomes/annotations/{dataset}/genes/eggNOG.tsv.gz", dataset="genomes"),
        "eggNOG_unbinned":              expand("genomes/annotations/{dataset}/genes/eggNOG.tsv.gz", dataset="unbinned"),
        "mmseqs2_easy_search":          expand("genomes/annotations/{dataset}/genes/mmseqs2_easy_search/finished", dataset="genomes"),
        "mmseqs2_easy_search_unbinned": expand("genomes/annotations/{dataset}/genes/mmseqs2_easy_search/finished", dataset="unbinned"),
    }
    annotations_requested = config.get("gene_annotations", [])

    try:
        annotations_files = [
            annotation_file_names[key] for key in annotations_requested
        ]
    except Exception as e:
        raise IOError(
            "Error in gene_annotations requested, check config file 'gene_annotations' "
        ) from e

    return annotations_files

rule gene_annotation:
    input:
        "finished_genomes",
        get_gene_annotations(),
    output:
        temp(touch("finished_gene_annotation")),



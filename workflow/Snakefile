## ---- ##
def get_genome_annotations():
    annotation_file_names = {
        "gtdb_tree":                      "genomes/annotations/genomes/tree/finished_gtdb_trees",
        "gtdb_taxonomy":                  "genomes/annotations/genomes/taxonomy/gtdb_taxonomy.tsv",
        "metaeuk":                        expand("genomes/annotations/{dataset}/metaeuk_mag_predictions.tsv.gz", dataset="genomes"),
        "metaeuk_unbinned":               expand("genomes/annotations/{dataset}/metaeuk_mag_predictions.tsv.gz", dataset="unbinned"),
        "mmseqs2_easy_taxonomy":          expand("genomes/annotations/{dataset}/mmseqs2_easy_taxonomy_{database_name}_result_tophit_aln.tsv.gz", dataset="genomes",  database_name=config["mmseqs2_database_name"]),
        "mmseqs2_easy_taxonomy_unbinned": expand("genomes/annotations/{dataset}/mmseqs2_easy_taxonomy_{database_name}_result_tophit_aln.tsv.gz", dataset="unbinned", database_name=config["mmseqs2_database_name"]),
    }
    annotations_requested = config.get("genome_annotations") or []

    try:
        annotations_files = [
            annotation_file_names[an] for an in annotations_requested
        ]
    except Exception as e:
        raise IOError(
            "Error in annotations requested, check config file 'genome_annotations' "
        ) from e

    return annotations_files

rule genome_annotation:
    input:
        "finished_genomes",
        *get_genome_annotations(),
    output:
        temp(touch("finished_genome_annotation")),



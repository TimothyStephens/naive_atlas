## ---- ##
def get_genome_annotations():
    annotation_file_names = {
        "gtdb_tree":        "genomes/annotations/genomes/tree/finished_gtdb_trees",
        "gtdb_taxonomy":    "genomes/annotations/genomes/taxonomy/gtdb_taxonomy.tsv",
        "dram":             "genomes/annotations/genomes/dram/finished",
        "metaeuk":          expand("genomes/annotations/{dataset}/metaeuk/finished", dataset="genomes"),
        "metaeuk_unbinned": expand("genomes/annotations/{dataset}/metaeuk/finished", dataset="unbinned"),
    }
    annotations_requested = config["genome_annotations"]

    try:
        annotations_files = [
            annotation_file_names[an] for an in annotations_requested
        ]
    except Exception as e:
        raise IOError(
            "Error in annotations requested, check config file 'genome_annotations' "
        ) from e

    return annotations_files

rule genome_annotation:
    input:
        "finished_genomes",
        *get_genome_annotations(),
    output:
        temp(touch("finished_genome_annotation")),


## ---- ##
def get_gene_annotations():
    annotation_file_names = {
        "eggNOG": "genomes/annotations/genes/eggNOG.tsv.gz",
        "dram": "genomes/annotations/genes/dram",
    }
    annotations_requested = config.get("gene_annotations", [])

    try:
        annotations_files = [
            annotation_file_names[key] for key in annotations_requested
        ]
    except Exception as e:
        raise IOError(
            "Error in gene_annotations requested, check config file 'gene_annotations' "
        ) from e

    return annotations_files

rule gene_annotation:
    input:
        "finished_genomes",
        get_gene_annotations(),
    output:
        temp(touch("finished_gene_annotation")),


## ---- ##
rule strains:
    input:
        "finished_genomes",
        "genomes/strains/comparison",
    output:
        temp(touch("finished_strains")),


## ---- ##
rule screen:
    input:
        "finished_QC",
        "QC/screen/sketch_comparison.tsv.gz",
    output:
        temp(touch("finished_screen")),


